# Regeneratable feature/ground-truth cache -- rebuild with:
#   python3 code/build_dataset.py
# (2GB+, and reconstructable from the raw TXM images + Ilastik exports on
# Desktop, which live outside this repo anyway)
dataset_cache/

# Regeneratable prediction cache -- the paint tool recomputes and
# repopulates this automatically whenever the model file changes
# (paint_common.py's auto-invalidation). Not meaningful to version.
paint/predicted_cache/

# Generated output images/overlays/stats from apply_pixel_model.py,
# retrain_and_deploy.py, and the various verification workflows this
# session. All regeneratable by re-running those scripts against the
# committed models + corrections.
results/

# Superseded experimental model (Random Forest, replaced by the
# HistGradientBoosting models) -- 570MB, over GitHub's 100MB per-file
# limit, would fail to push.
models/pixel_rf.joblib

# Python
code/__pycache__/
*.pyc

# OS
.DS_Store

# Flatfielded feature caches -- large and fully regeneratable:
#   python3 code/build_flatfield_dataset.py   (dataset_cache_flatfield/)
#   python3 code/train_flatfield_model.py     (paint/flatfield_featcache/, built on demand)
#   python3 code/apply_flatfield_all.py       (paint/flatfield_predcache/)
dataset_cache_flatfield/
paint/flatfield_featcache/
paint/flatfield_predcache/

# Generated outputs are gitignored (§ above) EXCEPT the deliverables that are
# small and expensive to recreate. The B&W crack masks are the actual product
# and binary PNGs compress to ~5MB for all 71; overlays are 558MB and are a
# pure rendering of mask+image, regenerated by build_final_outputs_v2.py in
# seconds. So: masks, stats, summaries and montages are TRACKED (force-added);
# overlays are not.
!results/final_71_v2/
!results/final_71_v2/*_crack_mask.png
!results/final_71_v2/*_stats.csv
!results/final_71_v2/summary.*
!results/final_71_v2/_montage_*.png
results/final_71_v2/*_overlay.png

# Paint tool prediction cache for the flatfielded pipeline -- regenerated
# automatically on demand (paint_common auto-invalidates on model change).
paint/predicted_cache_flatfield/

# Same policy for the raw-model outputs: masks/stats/summaries/montages tracked,
# large overlays excluded (regenerate with build_final_outputs_raw.py).
!results/final_71_raw/
!results/final_71_raw/*_crack_mask.png
!results/final_71_raw/*_stats.csv
!results/final_71_raw/summary.*
!results/final_71_raw/_montage_*.png
results/final_71_raw/*_overlay.png

# Per-group outputs: masks/stats/summaries/montages tracked, overlays excluded.
!results/final_71_pergroup/
!results/final_71_pergroup/*_crack_mask.png
!results/final_71_pergroup/*_stats.csv
!results/final_71_pergroup/summary.*
!results/final_71_pergroup/_montage_*.png
results/final_71_pergroup/*_overlay.png

# ---- app runtime data (uploads, embeddings, predictions, retrained models).
# Regenerated per user; the SAM embedding cache alone is ~30MB per image.
app_data/

# ---- 2026-08-17 cleanup ----
# The 71 hand-drawn correction masks are the irreplaceable artefact here, but as
# raw uint8 .npy they were 850 MB of tracked data. They are overwhelmingly zero
# and compress 257x, so the COMPRESSED archive is tracked instead and
# code/unpack_package.py restores the .npy files from it. Verified bit-identical.
paint/corrections/*_correction.npy
paint/corrections/*_painted.png
!paint/corrections/corrections.npz

# app runtime data: uploads, SAM embeddings, predictions, retrained models
app_data/
# SAM embedding cache: 2.1 GB, rebuilt on demand by cache_sam_embeddings.py
paint/sam_embcache/
# per-image prediction caches, all regenerable
paint/predicted_cache_pergroup/
paint/predicted_cache_hybrid/
.venv/
# on-demand destitch/flatfield cache, rebuilt by txm_preprocess.py
paint/preproc_cache/

# --- single-repo consolidation -------------------------------------------------
# This repo is now both the research archive and the thing a user clones and runs,
# so it has to TRACK the compressed reference data run_app.sh expands on first
# start. Previously dataset_cache/ was ignored wholesale and the runnable copy of
# these six files lived only in the separate txm-crack-detector repo -- which is
# exactly the split being removed. The .npy originals stay ignored: LARGE_343_75's
# is 94 MB, over GitHub's 100 MB per-file limit, which is why they ship as
# 16-bit PNG (1/65535 quantisation, measured to move IoU by 9e-06).
!dataset_cache/
dataset_cache/*
!dataset_cache/*_img.png
!dataset_cache/masks.npz
!dataset_cache/manifest.json

# --- raw source images ---------------------------------------------------------
# images/ is tracked ON PURPOSE. The 71 source TXM images are the thing every label
# in this repo refers to; without them the 264 M correction pixels and the 4 ground
# truth masks describe pictures nobody has. They are stored as deflate-compressed
# float32 TIFF with the floating-point predictor: bit-exact (verified 71/71 against
# the originals), 2.26 GB instead of 3.40 GB, and every file under GitHub's 100 MB
# per-file hard limit -- two of the originals were 122 MB and could not be pushed
# at all. Read them with tifffile/GDAL; if a tool cannot handle predictor 3, see
# the note in README.

# Derived cross-validation cache: 968 MB, rebuilt by code/build_label_folds.py
paint/label_folds.npz

# Tiles exported for annotation (regenerate with code/export_annotation_tiles.py)
paint/annotate/
