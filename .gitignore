# Regeneratable feature/ground-truth cache -- rebuild with:
#   python3 code/build_dataset.py
# (2GB+, and reconstructable from the raw TXM images + Ilastik exports on
# Desktop, which live outside this repo anyway)
dataset_cache/

# Regeneratable prediction cache -- the paint tool recomputes and
# repopulates this automatically whenever the model file changes
# (paint_common.py's auto-invalidation). Not meaningful to version.
paint/predicted_cache/

# Generated output images/overlays/stats from apply_pixel_model.py,
# retrain_and_deploy.py, and the various verification workflows this
# session. All regeneratable by re-running those scripts against the
# committed models + corrections.
results/

# Superseded experimental model (Random Forest, replaced by the
# HistGradientBoosting models) -- 570MB, over GitHub's 100MB per-file
# limit, would fail to push.
models/pixel_rf.joblib

# Python
code/__pycache__/
*.pyc

# OS
.DS_Store

# Flatfielded feature caches -- large and fully regeneratable:
#   python3 code/build_flatfield_dataset.py   (dataset_cache_flatfield/)
#   python3 code/train_flatfield_model.py     (paint/flatfield_featcache/, built on demand)
#   python3 code/apply_flatfield_all.py       (paint/flatfield_predcache/)
dataset_cache_flatfield/
paint/flatfield_featcache/
paint/flatfield_predcache/
